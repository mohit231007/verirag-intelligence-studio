VERIRAG_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

VERIRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VERIRAG_SIMILARITY_THRESHOLD=0.40
VERIRAG_TOP_K=4
VERIRAG_CHUNK_SIZE_CHARS=1800
VERIRAG_CHUNK_OVERLAP_CHARS=220

VERIRAG_MAX_FILE_MB=5
VERIRAG_MAX_FILES=5
VERIRAG_MAX_PAGES=200
VERIRAG_MAX_CHUNKS=1500
VERIRAG_MAX_CONTEXT_CHARS=16000
VERIRAG_REQUEST_TIMEOUT=60
