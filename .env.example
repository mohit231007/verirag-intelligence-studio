VERIRAG_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

VERIRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VERIRAG_RETRIEVAL_MODE=dense
VERIRAG_SIMILARITY_THRESHOLD=0.40
VERIRAG_TOP_K=4
VERIRAG_CANDIDATE_MULTIPLIER=3
VERIRAG_HYBRID_DENSE_WEIGHT=0.60
VERIRAG_RERANK_WEIGHT=0.20
VERIRAG_RRF_K=60
VERIRAG_LEXICAL_CANDIDATES=40

VERIRAG_CHUNK_SIZE_CHARS=1800
VERIRAG_CHUNK_OVERLAP_CHARS=220

VERIRAG_MAX_FILE_MB=5
VERIRAG_MAX_FILES=5
VERIRAG_MAX_PAGES=200
VERIRAG_MAX_CHUNKS=1500
VERIRAG_MAX_CONTEXT_CHARS=16000
VERIRAG_REQUEST_TIMEOUT=60

# Optional. Leave at 0 unless you explicitly want cost estimation in Benchmark Lab.
# Values are USD per 1,000,000 tokens for the model/provider you configured.
VERIRAG_INPUT_COST_PER_MILLION_USD=0
VERIRAG_OUTPUT_COST_PER_MILLION_USD=0
